{
  "name": "directive",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && stylelint 'starter/**/*.css' --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.mjs && node --experimental-strip-types --test directive-ai/tests/*.test.ts",
    "test:load": "node --experimental-strip-types directive-ai/tests/load-smoke.mjs",
    "start:ai": "node --experimental-strip-types directive-ai/server/src/http.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
